# Copy to .env and fill in. Never commit .env.
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Model names are configuration, never hard-coded. Pick from
# `GET https://api.groq.com/openai/v1/models` (see README "Choosing models").
# Vision model used by the VLM-direct pipeline (must accept image input).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional second vision model for the benchmark ("model B"); leave empty if none exists.
GROQ_VISION_MODEL_B=
# Text model for the OCR + LLM pipeline.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Text model for fuzzy semantic matching (MATCHING=rules+llm). A separate model = separate quota.
GROQ_MATCH_MODEL=openai/gpt-oss-20b
# reasoning_effort sent to text/match models that support it (none|low|medium|high); empty = omit.
GROQ_TEXT_REASONING_EFFORT=low

# Client-side rate limits applied per model (Groq free tier, check console.groq.com/settings/limits).
GROQ_RPM=30
GROQ_TPM=8000

# rules | rules+llm
MATCHING=rules+llm
# Where LLM / RxNorm responses are cached on disk (use /tmp/... on read-only hosts).
PAPERTRAIL_CACHE_DIR=.cache
# Longest a single call may wait for rate-limit capacity before giving up (seconds).
PAPERTRAIL_MAX_WAIT=120
# Longest image side sent to the vision model (pixels).
PAPERTRAIL_MAX_IMAGE_SIDE=1024
